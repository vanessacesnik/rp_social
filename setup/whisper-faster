#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Substituto do CLI `whisper` usando faster-whisper, para maquina sem GPU.

Existe porque a skill documenta, em varios modelos, exatamente este comando:

    whisper original.mp4 --model medium --language pt --word_timestamps True \
            --output_format json -o .

O openai-whisper roda isso com torch, e num VPS de CPU o `--model medium` leva mais
tempo que o proprio video. O faster-whisper entrega os MESMOS timestamps por palavra
varias vezes mais rapido na CPU, mas nao tem CLI compativel. Este arquivo e a ponte:
aceita as mesmas flags e escreve o MESMO formato de JSON, para que nenhuma linha dos
scripts ou dos modelos precise mudar.

Formato de saida (identico ao do openai-whisper com --word_timestamps True):
    {"text", "language", "segments":[{"id","start","end","text","words":[{"word","start","end","probability"}]}]}

O "word" sai com o espaco inicial, igual ao openai-whisper.
"""
import argparse, json, os, sys


def main():
    p = argparse.ArgumentParser(add_help=True, description="whisper compativel, via faster-whisper")
    p.add_argument("audio", nargs="+", help="arquivo(s) de audio ou video")
    p.add_argument("--model", default="medium", help="tiny, base, small, medium, large-v3 (padrao: medium)")
    p.add_argument("--language", default=None, help="codigo do idioma, ex: pt")
    p.add_argument("--word_timestamps", default="True", help="mantido por compatibilidade; aqui e sempre True")
    p.add_argument("--output_format", default="json", choices=["json", "all"])
    p.add_argument("-o", "--output_dir", default=".")
    p.add_argument("--device", default="auto", help="auto, cpu ou cuda")
    p.add_argument("--compute_type", default=None, help="padrao: int8 na CPU, float16 na GPU")
    p.add_argument("--beam_size", type=int, default=5)
    p.add_argument("--vad_filter", action="store_true",
                   help="NAO use no fluxo da skill: o VAD mexe nos limites e o corte com recuo "
                        "de 0,5s depende do timestamp cru da palavra.")
    a = p.parse_args()

    try:
        from faster_whisper import WhisperModel
    except ImportError:
        sys.exit("faster-whisper nao instalado. Rode: bash setup/instalar.sh")

    device = a.device
    if device == "auto":
        try:
            import ctranslate2
            device = "cuda" if ctranslate2.get_cuda_device_count() > 0 else "cpu"
        except Exception:
            device = "cpu"
    compute = a.compute_type or ("float16" if device == "cuda" else "int8")

    os.makedirs(a.output_dir, exist_ok=True)
    print(f"[whisper-faster] modelo={a.model} device={device} compute={compute}", file=sys.stderr)
    modelo = WhisperModel(a.model, device=device, compute_type=compute)

    for caminho in a.audio:
        segmentos, info = modelo.transcribe(
            caminho,
            language=a.language,
            beam_size=a.beam_size,
            word_timestamps=True,
            vad_filter=a.vad_filter,
        )
        segs, texto = [], []
        for i, s in enumerate(segmentos):
            palavras = [
                {"word": w.word, "start": round(w.start, 3), "end": round(w.end, 3),
                 "probability": round(w.probability, 4)}
                for w in (s.words or [])
            ]
            segs.append({"id": i, "start": round(s.start, 3), "end": round(s.end, 3),
                         "text": s.text, "words": palavras})
            texto.append(s.text)
            print(f"[{s.start:7.2f} -> {s.end:7.2f}] {s.text}", file=sys.stderr)

        destino = os.path.join(a.output_dir, os.path.splitext(os.path.basename(caminho))[0] + ".json")
        with open(destino, "w", encoding="utf-8") as f:
            json.dump({"text": "".join(texto), "language": info.language, "segments": segs},
                      f, ensure_ascii=False, indent=2)
        n = sum(len(s["words"]) for s in segs)
        print(f"[whisper-faster] {destino}  ({len(segs)} segmentos, {n} palavras)", file=sys.stderr)
        if n == 0:
            sys.exit("ERRO: zero palavras com timestamp. Sem isso nao ha corte nem legenda.")


if __name__ == "__main__":
    main()
